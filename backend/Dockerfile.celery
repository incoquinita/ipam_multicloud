# ────────────────────────────────────────────────────────────────────
# IPAM Scanner — Celery Worker Image
# Multi-stage build for running background scan tasks.
# ────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Stage 2: Runtime ──────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

# Create a non-root user for security.
RUN addgroup --system --gid 1001 appuser \
    && adduser --system --uid 1001 --ingroup appuser --home /app --shell /sbin/nologin appuser

# Copy application code and adjust ownership.
COPY --chown=appuser:appuser . .

# Switch to non-root user.
USER appuser

# Run Celery worker for the "scans", "cleanup", and "discovery" queues.
CMD ["celery", "-A", "app.workers.celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=4", \
     "--queues=scans,cleanup,discovery"]
