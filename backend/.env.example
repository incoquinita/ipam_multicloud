# ──────────────────────────────────────────────────────────────────
# IPAM Multi-Cloud Scanner — Environment Configuration
# Copy this file to .env and adjust before starting the application.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME=IPAM Multi-Cloud Scanner
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Database (PostgreSQL + asyncpg) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ipam_scanner
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ENCRYPTION_KEY must be a valid Fernet key (32 URL-safe base64 bytes).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example (DO NOT reuse this key in production):
#   ENCRYPTION_KEY=4LVdkUlUsuAnLqDcACqN-xQx5eQfKd8lLMlV-oWUIu8=
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# ── Admin User (seeded by Alembic migration 005) ──────────────────
# Used by `alembic upgrade head` to seed the first superuser.
# ⚠️  CHANGE THESE IMMEDIATELY in production — the defaults are weak
#     and exist only for local development convenience. The migration
#     prints a loud warning when these are not set.
ADMIN_EMAIL=admin@ipam.local
ADMIN_PASSWORD=ChangeMe123!

# ── CORS ──────────────────────────────────────────────────────────
# Explicit origins only — never use ["*"] with credentialed requests.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ── Scanner ───────────────────────────────────────────────────────
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=10

# ── Rate Limiting ─────────────────────────────────────────────────
GLOBAL_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=10/minute
